  "cypher": {
    "nodes_by_label": "MATCH (n) WHERE n.backbone_version = $version UNWIND labels(n) AS kind RETURN kind, count(*) AS count ORDER BY kind",
    "nodes_by_source": "MATCH (n) WHERE n.backbone_version = $version RETURN n.source AS kind, count(*) AS count ORDER BY kind",
    "relationships_by_type": "MATCH ()-[r]->() WHERE r.backbone_version = $version RETURN type(r) AS kind, count(*) AS count ORDER BY kind",
    "relationships_by_source": "MATCH ()-[r]->() WHERE r.backbone_version = $version RETURN r.source AS kind, count(*) AS count ORDER BY kind",
    "relationships_by_evidence": "MATCH ()-[r]->() WHERE r.backbone_version = $version RETURN r.evidence_class AS kind, count(*) AS count ORDER BY kind",
    "counts": "MATCH (n {backbone_version: 'v3'}) WITH count(n) AS nodes MATCH ()-[r {backbone_version: 'v3'}]->() RETURN nodes, count(r) AS relationships",
    "node_provenance": "MATCH (n {backbone_version:'v3'}) RETURN count(n) AS total,\n    count(CASE WHEN n.source IS NULL OR n.source_version IS NULL OR n.updated_at IS NULL THEN 1 END) AS incomplete",
    "relation_provenance": "MATCH ()-[r {backbone_version:'v3'}]->() RETURN count(r) AS total,\n    count(CASE WHEN r.source IS NULL OR r.source_version IS NULL OR r.updated_at IS NULL OR r.evidence_class IS NULL THEN 1 END) AS incomplete",
    "pathway_depth": "MATCH p=(:Pathway)-[:SUBPATHWAY_OF*0..20]->(root:Pathway)\n    WHERE NOT (root)-[:SUBPATHWAY_OF]->() RETURN max(length(p)) AS depth",
    "pathway_top_categories": "MATCH p=(x:Pathway)-[:SUBPATHWAY_OF*0..20]->(root:Pathway)\n    WHERE NOT (root)-[:SUBPATHWAY_OF]->() AND (x)-[:SUBPATHWAY_OF]-()\n    RETURN root.pathway_id AS top_id, root.name AS category, root.source AS source,\n    count(DISTINCT x) AS pathways, max(length(p)) AS depth ORDER BY source, pathways DESC, top_id",
    "metabolite_families": "MATCH (m:Metabolite {backbone_version:'v3'})\n    RETURN coalesce(m.chemical_family,'other') AS family, count(m) AS total,\n    sum(CASE WHEN 'v2' IN m.selection_routes THEN 1 ELSE 0 END) AS v2\n    ORDER BY family",
    "metabolite_classes": "MATCH (m:Metabolite {backbone_version:'v3'})\n    RETURN coalesce(m.class,'unclassified') AS class, count(m) AS total ORDER BY total DESC, class",
    "stage_genes": "MATCH (s:Stage {backbone_version:'v3'})\n    OPTIONAL MATCH (g:Gene)-[:ASSOCIATED_WITH {backbone_version:'v3'}]->(s)\n    RETURN s.stage_order AS stage, s.name AS name, count(DISTINCT g) AS genes ORDER BY stage",
    "gene_patterns": "MATCH (g:Gene {backbone_version:'v3'})\n    RETURN g.stage_pattern AS pattern, count(g) AS genes ORDER BY pattern",
    "stage_changes": "MATCH (:Gene)-[r:STAGE_DIFFERENTIAL {backbone_version:'v3'}]->(:Stage)\n    RETURN r.from_stage AS from_stage, r.to_stage AS to_stage, r.change AS change, count(r) AS genes\n    ORDER BY from_stage, change",
    "classification": "MATCH (root:BackboneClass {class_id:'LiverTrail:Entity'})\n    OPTIONAL MATCH (type:BackboneClass)-[:IS_A {backbone_version:'v3'}]->(root)\n    RETURN root.snapshot_id AS snapshot, collect(type.entity_label) AS entity_classes",
    "constraints": "SHOW CONSTRAINTS YIELD name, entityType, type, labelsOrTypes, properties\n    WHERE name STARTS WITH 'livertrail_backbone_' RETURN name, entityType, type, labelsOrTypes, properties ORDER BY name",
    "legacy_metabolite_edges": "MATCH (:Metabolite)-[r:ASSOCIATED_WITH {backbone_version:'v3'}]->(:Disease)\n    RETURN count(r) AS count",
    "metabolite_disease_counts": "MATCH (:Metabolite)-[r:METABOLITE_ASSOCIATED_WITH_DISEASE {backbone_version:'v3'}]->(:Stage)\n    RETURN r.source AS source, r.evidence_class AS evidence_class, count(r) AS count"
  },
