      "relationship_provenance": "MATCH ()-[r]->() RETURN count(r) AS total,\n        count(CASE WHEN r.source IS NULL OR trim(r.source) = '' OR r.source_version IS NULL\n          OR NOT (r.source_version IN $source_versions) OR r.updated_at IS NULL\n          OR r.backbone_version IS NULL OR r.backbone_version <> 'v2' OR r.evidence_class IS NULL\n          OR NOT (r.evidence_class IN ['direct_disease_evidence', 'contextual_background']) THEN 1 END) AS incomplete",
