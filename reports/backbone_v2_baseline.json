      "prognostic_cohorts": "MATCH (:Gene)-[r:PROGNOSTIC_IN]->(:Disease)\n        RETURN r.cohort AS cohort, count(r) AS records, count(r.p_value) AS records_with_p_value\n        ORDER BY cohort",
