{
  "llm": {
    "workers": 3,
    "provider": {
      "kind": "openai_compatible",
      "base_url_env": "LIVERKG_MAIN_API_BASE",
      "api_key_env": "LIVERKG_MAIN_API_KEY",
      "timeout_seconds": 120,
      "extra_body": {
        "enable_thinking": false
      }
    },
    "stages": {
      "audit_edges": {
        "model": "deepseek-v4.1-flash",
        "temperature": 0,
        "max_tokens": 6000
      }
    }
  },
  "extractor": {
    "provider": {
      "kind": "openai_compatible",
      "base_url_env": "LIVERKG_EXTRACT_API_BASE",
      "api_key_env": "LIVERKG_EXTRACT_API_KEY",
      "timeout_seconds": 100
    },
    "model": "gemini-3.8-flash",
    "max_workers": 1
  },
  "embedding": {
    "kind": "openai_compatible",
    "base_url_env": "LIVERKG_EMBED_API_BASE",
    "api_key_env": "LIVERKG_EMBED_API_KEY",
    "timeout_seconds": 90,
    "model": "qwen3.7-text-embedding",
    "dimensions": 1024,
    "batch_size": 20,
    "workers": 2
  }
}
